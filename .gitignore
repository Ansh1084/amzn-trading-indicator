# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables & secrets (NEVER commit)
.env
.env.*
!.env.example

# Testing & cache
.pytest_cache/
.coverage
htmlcov/

# Data and artifacts (preserve .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.joblib
*.pkl
*.pt
*.pth

# Frontend dependencies and builds
**/node_modules/
**/dist/
**/.vite/

# IDE / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
